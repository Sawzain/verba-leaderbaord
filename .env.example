# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas (or any Mongo) connection string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/verba

# The admin key required to add/edit/remove members.
# Generate one with: openssl rand -hex 24
API_KEY=

# Port the Express server listens on (optional, defaults to 5000)
PORT=5000

# Set this in production to the exact URL of your deployed frontend
# (e.g. https://verba.vercel.app or https://verba.com) so the API only
# accepts requests from your site. Leave unset locally.
FRONTEND_ORIGIN=