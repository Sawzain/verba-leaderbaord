# MongoDB Atlas connection string
MONGO_URI=

# Admin key for the Manage tab and add/remove endpoints — generate with:
# openssl rand -hex 24
API_KEY=

# Secret used to sign member login tokens — generate with:
# openssl rand -hex 32
JWT_SECRET=

# Cloudinary connection string, used to store book covers permanently
# (Render's free-tier disk is ephemeral, so covers can't live there).
# Get this from your Cloudinary dashboard's "API Environment variable" —
# it looks like: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Origin the frontend is served from, e.g. https://your-app.vercel.app
# Used for CORS and to know where to redirect back to after Discord login
# and after email verification.
FRONTEND_ORIGIN=

# This backend's own public URL, e.g. https://your-api.onrender.com
# Used to build the verification link sent in emails (that link hits this
# server directly, not the frontend).
BACKEND_ORIGIN=

# --- Optional ---

# Points awarded to a member's leaderboard score when they submit a review.
# Defaults to 10 if unset.
REVIEW_POINTS=10

# Whether members must verify their email before submitting a review.
# Defaults to false — leave unset while Resend's sending domain isn't
# verified yet, or if you don't want to gate reviews on this at all.
REQUIRE_EMAIL_VERIFICATION=false

# Whether a member's leaderboard score is automatically increased when
# they submit a review, instead of requiring an admin to award points by
# hand in the Manage tab. Defaults to false — see server/utils/points.js
# for why this is opt-in.
AUTO_AWARD_REVIEW_POINTS=false

# Supabase project used by the Twig Discord bot — powers the Verba Wall
# (GET /api/quotes). Get these from the Supabase dashboard for that
# project under Settings → API: SUPABASE_URL is the Project URL,
# SUPABASE_SERVICE_ROLE_KEY is the service_role key (not anon).
# Leaving these unset doesn't stop the server from starting — the Verba
# Wall tab just shows a "not configured" message until they're set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email verification) — free tier, sign up at resend.com.
# For testing you can send from "onboarding@resend.dev" without verifying
# a domain; for production, verify your own domain in the Resend dashboard
# and use an address on it instead. Leaving RESEND_API_KEY unset just logs
# verification links to the server console instead of emailing them.
RESEND_API_KEY=
EMAIL_FROM=Verba Book Club <onboarding@resend.dev>

# Discord OAuth (for "Continue with Discord" login). Leave unset to disable
# Discord login — everything else still works with email/password.
# Create an app at https://discord.com/developers/applications, add an
# OAuth2 redirect matching DISCORD_REDIRECT_URI below, and copy the
# Client ID / Client Secret from the OAuth2 page.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered on the Discord app, e.g.
# http://localhost:5000/api/auth/discord/callback in dev, or
# https://your-api.onrender.com/api/auth/discord/callback in prod.
DISCORD_REDIRECT_URI=